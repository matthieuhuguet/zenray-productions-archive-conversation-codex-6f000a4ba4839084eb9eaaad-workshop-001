function renderHtmlToPng(htmlContent, outPngPath) {
  const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'zr-diag-1080p-'))
  const htmlPath = path.join(tmpDir, 'diag.html')
  fs.writeFileSync(htmlPath, htmlContent, 'utf8')
  const args = [
    '--headless=new',
    '--disable-gpu',
    '--hide-scrollbars',
    '--no-first-run',
    '--no-default-browser-check',
    '--force-device-scale-factor=1',
    `--user-data-dir=${path.join(tmpDir, 'profile')}`,
    '--window-size=1920,1080',
    '--virtual-time-budget=2000',
    `--screenshot=${outPngPath}`,
    pathToFileURL(htmlPath).href,
  ]
  const res = spawnSync(CHROME, args, { encoding: 'utf8', timeout: 30000 })
  fs.rmSync(tmpDir, { recursive: true, force: true })
  if (res.status !== 0 || !fs.existsSync(outPngPath)) {
    throw new Error(`Chrome screenshot failed: ${res.stderr}`)
  }
}

